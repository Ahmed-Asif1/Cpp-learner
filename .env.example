# Upstash Redis / Vercel KV Database (Optional - progress falls back to localStorage if omitted)
# Create a free database at https://console.upstash.com or via Vercel KV
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# Vercel KV environment variable aliases
KV_REST_API_URL=https://your-database.upstash.io
KV_REST_API_TOKEN=your_upstash_redis_token

